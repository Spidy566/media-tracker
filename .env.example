# Database (Docker default)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tracklist

# TMDB API (Movies & TV) - https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Twitch / IGDB API (Games) - https://dev.twitch.tv/console
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here